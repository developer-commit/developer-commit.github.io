{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exam.schema.json",
  "title": "블로그 객관식 시험",
  "description": "content/exams/<id>.json 의 형식. 자세한 작성 규칙은 docs/EXAM_GUIDE.md.",
  "type": "object",
  "required": ["id", "title", "course", "description", "updated", "sections"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "URL에 쓰이는 시험 id. 파일 이름과 같아야 한다." },
    "title": { "type": "string", "minLength": 1 },
    "course": { "type": "string", "minLength": 1, "description": "과목·학기 등 짧은 출처 표시" },
    "description": { "type": "string", "minLength": 1 },
    "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "questions"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "questions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/question" } }
        }
      }
    }
  },
  "$defs": {
    "markdown": { "type": "string", "minLength": 1, "description": "마크다운. **굵게**, `코드`, ```코드 블록```, $수식$(KaTeX)" },
    "question": {
      "type": "object",
      "required": ["id", "type", "prompt", "choices", "answer", "explanation"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$", "description": "시험 안에서 유일. 한번 정하면 바꾸지 않는다(풀이 기록의 키)." },
        "type": { "type": "string", "minLength": 1, "description": "유형 태그: 개념, 정의, 옳지 않은 것, 조합, 순서, 계산, 코드 …" },
        "prompt": { "$ref": "#/$defs/markdown" },
        "box": {
          "description": "보기 상자. 배열이면 ㄱ·ㄴ·ㄷ… 라벨이 자동으로 붙는다. 문자열이면 그대로(코드·그림용).",
          "oneOf": [
            { "$ref": "#/$defs/markdown" },
            { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/markdown" } }
          ]
        },
        "choices": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "$ref": "#/$defs/markdown" } },
        "answer": { "type": "integer", "minimum": 1, "maximum": 6, "description": "정답 보기 번호. 1부터 센다 (1 = ①)." },
        "fixedOrder": { "type": "boolean", "description": "true면 '보기 섞기'를 켜도 순서를 유지한다 (순서·조합·숫자 크기순 보기)." },
        "explanation": { "$ref": "#/$defs/markdown" }
      }
    }
  }
}
